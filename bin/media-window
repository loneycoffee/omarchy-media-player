#!/usr/bin/env python3
"""Find (and focus) the Hyprland window an MPRIS player is playing in.

    media-window find  BUS_NAME [TITLE] [IDENTITY] [DESKTOP_ENTRY] [URL]
    media-window focus BUS_NAME [TITLE] [IDENTITY] [DESKTOP_ENTRY] [URL]

`find` prints JSON: {address, class, title, workspace, app}, where `app` is
the service behind the player when it can be told (youtube, spotify, ...),
from the track URL, the window title or the web-app class. `focus` does the
same lookup, then focuses that window, which switches to its workspace.

The window is found through the process that owns the player's bus name: the
window whose pid is that process or one of its parents (mpv in a terminal
lands on the terminal). A browser has many windows on one pid, so the one
whose title holds the track title wins, then the most recently focused.
"""
import json
import os
import re
import subprocess
import sys

# Checked in order against the URL, the window class and the window title.
SERVICES = [
    ("youtubemusic", [r"music\.youtube\.com", r"youtube music"]),
    ("youtube", [r"youtube\.com", r"youtu\.be", r"- youtube\b", r"\byoutube\b"]),
    ("spotify", [r"spotify"]),
    ("soundcloud", [r"soundcloud"]),
    ("twitch", [r"twitch\.tv", r"- twitch\b", r"\btwitch\b"]),
    ("netflix", [r"netflix"]),
    ("applemusic", [r"music\.apple\.com", r"apple music"]),
    ("tidal", [r"tidal\.com", r"\btidal\b"]),
    ("deezer", [r"deezer"]),
]


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def bus_pid(name):
    out = run(["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
               "org.freedesktop.DBus", "GetConnectionUnixProcessID", "s", name])
    m = re.match(r"u (\d+)", out.strip())
    return int(m.group(1)) if m else 0


def lineage(pid):
    """The pid and every parent up to init."""
    chain = []
    while pid > 1 and pid not in chain:
        chain.append(pid)
        try:
            with open(f"/proc/{pid}/stat") as f:
                # comm may hold spaces and parens; the ppid follows the last ')'.
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            break
    return chain


def norm(s):
    return re.sub(r"\s+", " ", str(s or "")).strip().lower()


def detect_app(*texts):
    for key, patterns in SERVICES:
        for text in texts:
            t = norm(text)
            if t and any(re.search(p, t) for p in patterns):
                return key
    return ""


def find(bus, title, identity, entry, url):
    try:
        clients = json.loads(run(["hyprctl", "clients", "-j"]) or "[]")
    except ValueError:
        clients = []
    clients = [c for c in clients if c.get("mapped", True) and c.get("address")]

    pids = lineage(bus_pid(bus)) if bus else []
    candidates = [c for c in clients if c.get("pid") in pids]
    if not candidates:
        # Sandboxed players (Flatpak) own the bus name from another pid; fall
        # back to the window class.
        names = {norm(n) for n in (entry, identity) if n}
        short = re.sub(r"^org\.mpris\.mediaplayer2\.", "", norm(bus))
        short = re.sub(r"\.instance[_0-9]+$", "", short)
        if short:
            names.add(short)
        candidates = [c for c in clients
                      if any(n and (n in norm(c.get("class")) or n in norm(c.get("initialClass")))
                             for n in names)]

    want = norm(title)

    def score(c):
        s = 0
        if want and want in norm(c.get("title")):
            s += 100
        # Chromium web apps ("brave-web.whatsapp.com__-Default") share the
        # browser's pid; only pick one when its title says so.
        if "__" in str(c.get("class", "")):
            s -= 10
        return (s, -c.get("focusHistoryID", 999))

    best = max(candidates, key=score) if candidates else None
    wtitle = best.get("title", "") if best else ""
    wclass = best.get("class", "") if best else ""
    title_matches = bool(best and want and want in norm(wtitle))

    app = detect_app(url, entry, identity)
    if not app and best:
        app = detect_app(wclass) or (detect_app(wtitle) if title_matches or "__" in wclass else "")

    return {
        "address": best.get("address", "") if best else "",
        "class": wclass,
        "title": wtitle,
        "workspace": (best.get("workspace") or {}).get("name", "") if best else "",
        "app": app,
    }


def main(argv):
    if len(argv) < 3 or argv[1] not in ("find", "focus"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    args = (argv[2:] + [""] * 5)[:5]
    win = find(*args)
    if argv[1] == "focus" and win["address"]:
        run(["hyprctl", "dispatch", 'hl.dsp.focus({ window = "address:%s" })' % win["address"]])
    print(json.dumps(win))
    return 0 if win["address"] or argv[1] == "find" else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
